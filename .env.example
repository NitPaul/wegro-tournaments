# WeGro Tournaments — configuration
#
# Copy to `.env` and fill in. The server checks all of this at boot and refuses
# to start with a clear message if something required is missing, rather than
# starting in a half-working state you discover on match day.

# --- Networking -------------------------------------------------------------

PORT=3000
HOST=0.0.0.0

# The full origin the site is served from. REQUIRED in production.
# It decides whether session cookies are marked Secure, and it is used for the
# absolute URLs in link previews. Getting this wrong makes sign-in fail in a way
# that looks like a wrong password, so check it twice.
PUBLIC_URL=http://localhost:3000

# --- Storage ----------------------------------------------------------------

# Where the SQLite file lives. In Docker this is a mounted volume, so the data
# survives rebuilding the image. Backing up is copying this one file.
DATA_DIR=./data
DATABASE_FILE=wegro.sqlite
BACKUP_DIR=./backups

# --- Sessions ---------------------------------------------------------------

# Signs session cookies. At least 32 characters. Changing it signs everyone out.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# How long a sign-in lasts. 30 days means the referee is still signed in on the
# day even if he set his phone up a fortnight earlier.
SESSION_DAYS=30

# --- First run --------------------------------------------------------------

# Creates the first super admin on the very first boot, because nothing inside
# the app can create one without a super admin already existing. Once the
# account exists these are ignored — remove SUPER_ADMIN_PASSWORD from this file
# after signing in.
#
# SUPER_ADMIN_USERNAME is the User ID to sign in with (3–32 letters, numbers,
# dots, dashes or underscores). If it is left empty, the part of
# SUPER_ADMIN_EMAIL before the @ is used. The email itself is optional.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=

# --- Behaviour --------------------------------------------------------------

# There is no public sign-up. The super admin creates every other account in the
# console (Accounts), each one for a single tournament.

NODE_ENV=production
LOG_LEVEL=info
